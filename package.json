{
  "name": "chuli-dev-libs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Typescript libraries monorepo",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "postinstall": "husky && npm run build",
    "build": "tsc -b tsconfig.build.esm.json tsconfig.build.cjs.json && npm run write-pkg-jsons",
    "build:clean": "npm run write-pkg-jsons -- --clean && tsc -b tsconfig.build.esm.json tsconfig.build.cjs.json --clean",
    "write-pkg-jsons": "npm run start:cli -- write-dist-package-jsons",
    "start:cli": "npm run start --workspace=@chuli-dev/cli --",
    "start:example": "npm run start --workspace=@chuli-dev/example",
    "format:check": "prettier --check .",
    "lint:check": "npm run lint:check --workspaces --if-present"
  },
  "author": "chuli-dev",
  "prettier": "@chuli-dev/prettier-config",
  "devDependencies": {
    "@chuli-dev/prettier-config": "*",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@types/node": "^25.2.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
