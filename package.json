{
  "name": "chuli-dev-libs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Typescript libraries monorepo",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "types:check": "npm run types:check --workspaces --if-present",
    "format:check": "prettier --check .",
    "lint:check": "npm run lint:check --workspaces --if-present",
    "start:dev:example": "npm run --workspace=@chuli-dev/example start:dev"
  },
  "author": "chuli-dev",
  "prettier": "@chuli-dev/prettier-config",
  "devDependencies": {
    "@chuli-dev/prettier-config": "*",
    "@types/node": "^25.2.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
