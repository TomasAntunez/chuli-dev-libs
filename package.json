{
  "name": "chuli-dev-libs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Typescript libraries monorepo",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build:eslint-config": "npm run --workspace=@chuli-dev/eslint-config build",
    "check-pack:typescript-config": "npm pack --dry-run --workspace=@chuli-dev/typescript-config",
    "check-pack:eslint-config": "npm pack --dry-run --workspace=@chuli-dev/eslint-config",
    "publish:typescript-config": "npm publish --workspace=@chuli-dev/typescript-config",
    "publish:eslint-config": "npm publish --workspace=@chuli-dev/eslint-config",
    "start:dev:example": "npm run --workspace=@chuli-dev/example start:dev"
  },
  "author": "chuli-dev",
  "devDependencies": {
    "@types/node": "^25.2.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
