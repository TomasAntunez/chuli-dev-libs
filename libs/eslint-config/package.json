{
  "name": "@chuli-dev/eslint-config",
  "version": "2.0.0",
  "type": "module",
  "description": "ESLint base configuration for libraries and applications",
  "keywords": [
    "eslint",
    "config"
  ],
  "author": "chuli-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TomasAntunez/chuli-dev-libs.git",
    "directory": "libs/eslint-config"
  },
  "homepage": "https://github.com/TomasAntunez/chuli-dev-libs/blob/main/libs/eslint-config/README.md",
  "bugs": {
    "url": "https://github.com/TomasAntunez/chuli-dev-libs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepare": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@chuli-dev/typescript-config": "*",
    "@eslint/js": ">=9",
    "eslint": ">=9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": ">=17",
    "eslint-plugin-simple-import-sort": ">=12",
    "eslint-plugin-unused-imports": ">=4",
    "globals": ">=16",
    "typescript-eslint": ">=8"
  },
  "peerDependencies": {
    "@eslint/js": ">=9",
    "eslint": ">=9",
    "eslint-config-prettier": ">=10",
    "eslint-plugin-n": ">=17",
    "eslint-plugin-simple-import-sort": ">=12",
    "eslint-plugin-unused-imports": ">=4",
    "globals": ">=16",
    "typescript": ">=5",
    "typescript-eslint": ">=8"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "sideEffects": false
}
